#!/usr/bin/env bash
# Syncs Claude Project HTML files into the GitHub Pages repo and pushes.
set -euo pipefail

REPO="$(cd "$(dirname "$0")" && pwd)"
PROJECTS="/Users/sophiahu/Documents/Claude/Projects"

echo "→ Copying files..."

cp "$PROJECTS/Leetcode/interview_training_plan.html"   "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/learning_journal.html"           "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/js-learning-journal.html"        "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/typescript-prep-plan.html"      "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/July-Studying-Schedule.html"    "$REPO/"
cp "$PROJECTS/Leetcode/Upcoming-Interviews.html"       "$REPO/"
cp "$PROJECTS/Leetcode/coding_interview_playbook.html" "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/leetcode_cheatsheet.html"       "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/ui_interview_playbook.html"     "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/ui_cheatsheet.html"             "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/systems_design_playbook.html"   "$REPO/Interview Prep/"
cp "$PROJECTS/Leetcode/systems_design_study_guide.html" "$REPO/Interview Prep/"
cp "$PROJECTS/Trip-Planning/korea-october.html"         "$REPO/Trip-Planning/"
cp "$PROJECTS/Trip-Planning/montreal-worlds-2026.html"  "$REPO/Trip-Planning/"
cp "$PROJECTS/Cycling Training/DiabloTrainingPlanV3.html" "$REPO/Cycling Training/"
cp "$PROJECTS/Roommate-Search/site/single-room.html"      "$REPO/Roommate-Search/"
rsync -a --delete "$PROJECTS/Roommate-Search/site/assets/" "$REPO/Roommate-Search/assets/"

echo "→ Committing..."
cd "$REPO"
git add -A
if git diff --cached --quiet; then
  echo "  Nothing changed, nothing to commit."
else
  git commit -m "sync: $(date '+%Y-%m-%d %H:%M')"
  echo "→ Pushing..."
  git push
  echo "✓ Done — https://sophiawho.github.io"
fi
